@page "/Track"

<PageTitle>Track</PageTitle>

<h1>Tracks</h1>

@if (tracks == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <a class="btn btn-success" href="/Track/Create">Create</a>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th colspan="3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var track in tracks)
            {
                <tr>
                    <td>@track.Name</td>
                    <td>@track.Description</td>
                    <td>
                        <a class="btn btn-primary" href="/Track/Edit/@track.Id">Edit</a>
                    </td>
                    <td>
                        <a class="btn btn-warning" href="/Track/Details/@track.Id">Details</a>
                    </td>
                    <td>
                        <a class="btn btn-danger" href="/Track/Delete/@track.Id">Delete</a>
                    </td> 
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<Track>? tracks;

    [Inject]
    public ITrackService TrackService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        tracks = await TrackService.GetTracks();
    }
}